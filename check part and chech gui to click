RunService.Stepped:Connect(function()
    if not attackActive or not selectedAttackTarget or flingMode then return end
    local p = Players:FindFirstChild(selectedAttackTarget)
    if not p or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local targetHRP = p.Character.HumanoidRootPart
    local tVel = targetHRP.AssemblyLinearVelocity
    
    local horizontalVel = Vector3.new(tVel.X, 0, tVel.Z)
    local verticalVel = tVel.Y
    
    -- Đã sửa đứng cách sau lưng 5 studs
    local targetCFrame = targetHRP.CFrame * CFrame.new(0, 0, 6)
    
    if horizontalVel.Magnitude > 3 then
        local leadFactor = 0.22
        local predictedPos = targetHRP.Position + (horizontalVel * leadFactor)
        targetCFrame = CFrame.new(predictedPos, predictedPos + horizontalVel.Unit) * CFrame.new(0, 0, 5)
    end
    
    if math.abs(verticalVel) > 5 then
        local verticalOffset = verticalVel < 0 and -2.5 or 1.5
        local predictedY = targetHRP.Position.Y + (verticalVel * 0.18) + verticalOffset
        targetCFrame = CFrame.new(targetCFrame.Position.X, predictedY, targetCFrame.Position.Z) * CFrame.Angles(0, targetHRP.Orientation.Y, 0)
    end
    
    hrp.CFrame = targetCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end)

local function triggerMobilePunchButton()
    local punchBtn = nil
    
    if ReplicatedFirst:FindFirstChild("MobileFrame") and ReplicatedFirst.MobileFrame:FindFirstChild("PunchButton") then
        punchBtn = ReplicatedFirst.MobileFrame.PunchButton
    end
    
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local found = playerGui:FindFirstChild("PunchButton", true)
        if found then punchBtn = found end
    end

    if punchBtn and punchBtn:IsA("GuiButton") and punchBtn.Visible then
        pcall(function()
            for _, conn in ipairs(getconnections(punchBtn.MouseButton1Click)) do
                conn:Fire()
            end
            for _, conn in ipairs(getconnections(punchBtn.Activated)) do
                conn:Fire()
            end
        end)
    end
end

