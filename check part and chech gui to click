-- Hàm tạo Nút Copy kèm hiệu ứng Hover nổi màu và khoanh vùng viền
local function createCopyButton(text, pos, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 80, 0, 26)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = text
    btn.Parent = mainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = btn
    
    -- Viền khoanh vùng cho nút
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.5
    stroke.Thickness = 1.5
    stroke.Parent = btn

    -- Hiệu ứng Rê chuột (Hover) nổi màu và sáng viền lên
    btn.MouseEnter:Connect(function()
        stroke.Color = Color3.fromRGB(255, 255, 0) -- Viền đổi sang màu vàng sáng rực
        stroke.Transparency = 0
        stroke.Thickness = 2.5
        btn.BackgroundColor3 = Color3.new(
            math.min(color.R + 0.2, 1),
            math.min(color.G + 0.2, 1),
            math.min(color.B + 0.2, 1)
        )
    end)

    btn.MouseLeave:Connect(function()
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 0.5
        stroke.Thickness = 1.5
        btn.BackgroundColor3 = color -- Trở về màu gốc
    end)

    return btn
end

