local function createCopyButton(text, pos, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 80, 0, 26)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = text
    btn.Parent = mainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = btn
    return btn
end

local btnName = createCopyButton("Copy Name", UDim2.new(0, 8, 1, -32), Color3.fromRGB(0, 120, 215))
local btnParent = createCopyButton("Copy Parent", UDim2.new(0, 93, 1, -32), Color3.fromRGB(100, 50, 200))
local btnPath = createCopyButton("Copy Path", UDim2.new(0, 178, 1, -32), Color3.fromRGB(40, 167, 69))
local btnPos = createCopyButton("Copy Pos", UDim2.new(0, 263, 1, -32), Color3.fromRGB(220, 100, 0))
local btnSize = createCopyButton("Copy Size", UDim2.new(0, 348, 1, -32), Color3.fromRGB(180, 40, 80))

local function handleCopy(textToCopy, button, defaultText, defaultColor)
    if textToCopy ~= "" and setclipboard then
        setclipboard(textToCopy)
        button.Text = "Đã Copy!"
        button.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        button.TextColor3 = Color3.fromRGB(0, 0, 0)
        task.wait(1.2)
        button.Text = defaultText
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        button.BackgroundColor3 = defaultColor
    end
end

btnName.MouseButton1Click:Connect(function() handleCopy(currentName, btnName, "Copy Name", Color3.fromRGB(0, 120, 215)) end)
btnParent.MouseButton1Click:Connect(function() handleCopy(currentParent, btnParent, "Copy Parent", Color3.fromRGB(100, 50, 200)) end)
btnPath.MouseButton1Click:Connect(function() handleCopy(currentPath, btnPath, "Copy Path", Color3.fromRGB(40, 167, 69)) end)
btnPos.MouseButton1Click:Connect(function() handleCopy(currentPosStr, btnPos, "Copy Pos", Color3.fromRGB(220, 100, 0)) end)
btnSize.MouseButton1Click:Connect(function() handleCopy(currentSizeStr, btnSize, "Copy Size", Color3.fromRGB(180, 40, 80)) end)

-- Hàm quét và bắt mọi đối tượng GUI xuất hiện tại vị trí chạm
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        
        -- Lấy tất cả các GUI tại tọa độ ngón tay chạm vào
        local objectsAtPos = {}
        pcall(function()
            objectsAtPos = LocalPlayer.PlayerGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
        end)
        
        local targetGUI = nil
        for _, gui in ipairs(objectsAtPos) do
            -- Bỏ qua GUI của chính tool này để không tự bắt nhầm
            if not gui:IsDescendantOf(screenGui) and gui.Visible then
                targetGUI = gui
                break
            end
        end
        
        -- Nếu không tìm thấy qua PlayerGui, thử quét rộng sang CoreGui hoặc dùng hàm tìm kiếm thông thường
        if not targetGUI then
            pcall(function()
                local coreObjects = CoreGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
                for _, gui in ipairs(coreObjects) do
                    if not gui:IsDescendantOf(screenGui) and gui.Visible then
                        targetGUI = gui
                        break
                    end
                end
            end)
        end
        
        if targetGUI then
            -- Nếu tìm thấy GUI / Button bất kỳ
            highlight.Adornee = nil
            uiBox.Visible = true
            uiBox.Position = UDim2.new(0, targetGUI.AbsolutePosition.X, 0, targetGUI.AbsolutePosition.Y)
            uiBox.Size = UDim2.new(0, targetGUI.AbsoluteSize.X, 0, targetGUI.AbsoluteSize.Y)
            
            currentType = "GUI Element (Button/Frame)"
            currentName = targetGUI.Name
            currentParent = targetGUI.Parent and targetGUI.Parent.Name or "Không có"
            currentPath = targetGUI:GetFullName()
            
            local pos = targetGUI.AbsolutePosition
            local size = targetGUI.AbsoluteSize
            currentPosStr = string.format("X: %.0f, Y: %.0f", pos.X, pos.Y)
            currentSizeStr = string.format("W: %.0f | H: %.0f", size.X, size.Y)
            
            statusLabel.Text = "• Loại: " .. currentType ..
                               "\n• Tên: " .. currentName ..
                               "\n• Parent: " .. currentParent ..
                               "\n• Vị trí: " .. currentPosStr ..
                               "\n• Kích thước: " .. currentSizeStr ..
                               "\n• Path: " .. currentPath
        else
            -- Nếu chạm ra ngoài không trúng GUI nào, tiến hành soi Part 3D
            uiBox.Visible = false
            local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            local char = LocalPlayer.Character
            raycastParams.FilterDescendantsInstances = char and {char, screenGui} or {screenGui}
            
            local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
            if result and result.Instance and result.Instance:IsA("BasePart") then
                local targetPart = result.Instance
                currentType = "3D Part"
                currentName = targetPart.Name
                currentParent = targetPart.Parent and targetPart.Parent.Name or "Không có"
                currentPath = targetPart:GetFullName()
                
                local pos = targetPart.Position
                local size = targetPart.Size
                currentPosStr = string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
                currentSizeStr = string.format("X: %.2f | Y: %.2f | Z: %.2f", size.X, size.Y, size.Z)
                
                statusLabel.Text = "• Loại: " .. currentType ..
                                   "\n• Tên Part: " .. currentName ..
                                   "\n• Parent: " .. currentParent ..
                                   "\n• Tọa độ: " .. currentPosStr ..
                                   "\n• Kích thước: " .. currentSizeStr ..
                                   "\n• Path: " .. currentPath
                
                highlight.Adornee = targetPart:FindFirstAncestorOfClass("Model") or targetPart
            end
        end
    end
end)
