-- Luôn luôn Dịch chuyển/Ghim vị trí tới mục tiêu khi bật Chế độ Đánh
RunService.Heartbeat:Connect(function()
    if not attackActive or not selectedAttackTarget then return end
    local p = Players:FindFirstChild(selectedAttackTarget)
    if not p or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local targetHRP = p.Character.HumanoidRootPart
    local predictedCFrame = targetHRP.CFrame + (targetHRP.AssemblyLinearVelocity * 0.15)
    hrp.CFrame = predictedCFrame * CFrame.new(0, 0, 3.5)
end)

-- Hàm kích hoạt nút PunchButton trên điện thoại khi xuất hiện trong ReplicatedFirst hoặc PlayerGui
local function triggerMobilePunchButton()
    local punchBtn = nil
    
    if ReplicatedFirst:FindFirstChild("MobileFrame") and ReplicatedFirst.MobileFrame:FindFirstChild("PunchButton") then
        punchBtn = ReplicatedFirst.MobileFrame.PunchButton
    end
    
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local found = playerGui:FindFirstChild("PunchButton", true)
        if found then punchBtn = found end
    end

    if punchBtn and punchBtn:IsA("GuiButton") and punchBtn.Visible then
        pcall(function()
            for _, conn in ipairs(getconnections(punchBtn.MouseButton1Click)) do
                conn:Fire()
            end
            for _, conn in ipairs(getconnections(punchBtn.Activated)) do
                conn:Fire()
            end
        end)
    end
end

-- CODE TUNG CHIÊU & ĐẤM THƯỜNG (PC & MOBILE): Chỉ thực hiện khi đã áp sát trong khoảng 10 studs
task.spawn(function()
    local skills = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    local skillIndex = 1
    while true do
        if attackActive and selectedAttackTarget then
            local p = Players:FindFirstChild(selectedAttackTarget)
            local char = LocalPlayer.Character
            
            -- Kiểm tra nếu mục tiêu còn tồn tại và khoảng cách <= 10 studs thì MỚI tung chiêu/đấm
            if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and char and char:FindFirstChild("HumanoidRootPart") then
                local targetHRP = p.Character.HumanoidRootPart
                local hrp = char.HumanoidRootPart
                local dist = (hrp.Position - targetHRP.Position).Magnitude
                
                if dist <= 10 and (p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0) then
                    pcall(function()
                        -- 1. PC: ĐÁNH THƯỜNG (Click chuột trái M1)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                        task.wait(0.03)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)

                        -- 2. PC: TUNG CHIÊU SKILL 1-4
                        local key = skills[skillIndex]
                        VirtualInputManager:SendKeyEvent(true, key, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, key, false, game)
                        
                        -- 3. Điện thoại: Kích hoạt nút PunchButton
                        triggerMobilePunchButton()
                        
                        -- 4. Điện thoại: Nhấn vùng chiêu Backpack
                        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                        if playerGui then
                            local hotbar = playerGui:FindFirstChild("Hotbar")
                            if hotbar and hotbar:FindFirstChild("Backpack") then
                                local backpackUI = hotbar.Backpack
                                if backpackUI.AbsolutePosition.X > 0 then
                                    local sectionWidth = backpackUI.AbsoluteSize.X / 4
                                    local targetX = backpackUI.AbsolutePosition.X + (sectionWidth * (skillIndex - 1)) + (sectionWidth / 2)
                                    local targetY = backpackUI.AbsolutePosition.Y + (backpackUI.AbsoluteSize.Y / 2)
                                    
                                    VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
                                    task.wait(0.05)
                                    VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
                                end
                            end
                        end
                    end)
                    skillIndex = skillIndex % #skills + 1
                    task.wait(0.5) -- Tốc độ đánh mượt mà
                else
                    task.wait(0.1) -- Nếu chưa vào tầm 10 studs thì đứng đợi cho dịch chuyển áp sát
                end
            else
                task.wait(0.3)
            end
        else
            task.wait(0.5)
        end
    end
end)

