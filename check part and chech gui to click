-- 3. ULTRA ANTI-LAG (SIẾT CHẶT WHITELIST: CHỈ GIỮ MainPart & Workspace.Map.Walls)
---------------------------------------------------------
local ExtremeBtn = Instance.new("TextButton")
ExtremeBtn.Size = UDim2.new(1, 0, 0, 35)
ExtremeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 120)
ExtremeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ExtremeBtn.Text = "Bật Ultra Anti-Lag (Chỉ Giữ Part Ảnh)"
ExtremeBtn.TextSize = 13
ExtremeBtn.Font = Enum.Font.SourceSansBold
ExtremeBtn.Parent = ContentContainer

local extremeActivated = false

ExtremeBtn.MouseButton1Click:Connect(function()
    if extremeActivated then return end
    extremeActivated = true
    ExtremeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    ExtremeBtn.Text = "Đã Tắt VFX & Xóa Bản Đồ Rác"

    -- ANTI-AFK ENGINE
    task.spawn(function()
        local VirtualUser = game:GetService("VirtualUser")
        LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
        while task.wait(300) do
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                task.wait(0.1)
                VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            end)
        end
    end)

    -- KIỂM TRA CHÍNH XÁC DANH SÁCH PART ĐƯỢC PHÉP GIỮ
    local function isWhitelistedPart(obj)
        local mapFolder = workspace:FindFirstChild("Map")
        if mapFolder then
            -- 1. Đúng chính xác Part MainPart trong Map
            if obj.Name == "MainPart" and obj.Parent == mapFolder then
                return true
            end
            
            -- 2. Đúng chính xác các Part thuộc folder Workspace.Map.Walls
            local wallsFolder = mapFolder:FindFirstChild("Walls")
            if wallsFolder and obj:IsDescendantOf(wallsFolder) then
                return true
            end
        end
        return false
    end

    -- XỬ LÝ ẨN TẤT CẢ VÀ TẮT VA CHẠM (TRỪ NHỮNG PART WHITELIST)
    local function processObject(obj)
        -- Xóa VFX / Hiệu ứng
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") 
           or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Explosion") 
           or obj:IsA("Sparkles") or obj:IsA("Highlight") or obj:IsA("Decal") 
           or obj:IsA("Texture") or obj:IsA("Clouds") or obj:IsA("Sky") 
           or obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("BlurEffect")
           or obj:IsA("SunRaysEffect") or obj:IsA("ColorCorrectionEffect")
           or obj:IsA("BloomEffect") or obj:IsA("DepthOfFieldEffect") then
            
            pcall(function() obj:Destroy() end)

        elseif (obj:IsA("BasePart") or obj:IsA("MeshPart")) then
            -- Nếu nằm trong Whitelist -> Giữ lại, hiển thị, cho phép chạm & làm mượt khối
            if isWhitelistedPart(obj) then
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
                obj.Transparency = 0
                obj.CanCollide = true
            elseif not obj:IsDescendantOf(LocalPlayer.Character) then
                -- Tất cả các Part khác (không thuộc nhân vật) -> Ẩn hoàn toàn & tắt va chạm
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
                if not obj.Parent:FindFirstChildOfClass("Humanoid") then
                    obj.Transparency = 1
                    obj.CanCollide = false
                end
            end
        end
    end

    for _, obj in ipairs(game:GetDescendants()) do
        processObject(obj)
    end

    Lighting.GlobalShadows = false
    Lighting.ClockTime = 14
    Lighting.FogEnd = 9e9

    game.DescendantAdded:Connect(function(obj)
        task.delay(0.01, function()
            processObject(obj)
        end)
    end)
end)
