local startPosFling = nil
local currentFlingIndex = 1
local flingMode = nil 

local FlingOnceBtn = Instance.new("TextButton")
FlingOnceBtn.Size = UDim2.new(1, 0, 0, 32)
FlingOnceBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 40)
