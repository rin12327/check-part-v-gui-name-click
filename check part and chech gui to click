FlingLoopBtn.Parent = ContentContainer

local function toggleFling(mode, btn)
    local char = LocalPlayer.Character
    if flingMode == mode then
        flingMode = nil
        btn.BackgroundColor3 = Color3.fromRGB(180, 80, 40)
        if mode == "ONCE" and startPosFling and char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = startPosFling
            startPosFling = nil
        end
    else
        flingMode = mode
        currentFlingIndex = 1
        btn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        if mode == "ONCE" and char and char:FindFirstChild("HumanoidRootPart") and not startPosFling then
            startPosFling = char.HumanoidRootPart.CFrame
        end
    end
end

FlingOnceBtn.MouseButton1Click:Connect(function() toggleFling("ONCE", FlingOnceBtn) end)
FlingLoopBtn.MouseButton1Click:Connect(function() toggleFling("LOOP", FlingLoopBtn) end)

local flipJitter = false
RunService.Heartbeat:Connect(function()
    if not flingMode or #selectedFlingPlayers == 0 then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if currentFlingIndex > #selectedFlingPlayers then
        if flingMode == "ONCE" then
            toggleFling("ONCE", FlingOnceBtn)
            return
        else
            currentFlingIndex = 1
        end
    end
    
    local targetName = selectedFlingPlayers[currentFlingIndex]
    local p = Players:FindFirstChild(targetName)
    
    if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        local targetHRP = p.Character.HumanoidRootPart
        local tVel = targetHRP.AssemblyLinearVelocity
        
        local moveDir = tVel.Magnitude > 2 and tVel.Unit or targetHRP.CFrame.LookVector
        local predictedPos = targetHRP.Position + (tVel * 0.25)
        
        flipJitter = not flipJitter
        local jitterOffset = flipJitter and 3 or -3 
        
        hrp.CFrame = CFrame.new(predictedPos + (moveDir * jitterOffset))
        
        hrp.AssemblyLinearVelocity = Vector3.new(90000, 90000, 90000)
        hrp.AssemblyAngularVelocity = Vector3.new(90000, 90000, 90000)
        
        if tVel.Magnitude > 200 or (targetHRP.Position - hrp.Position).Magnitude > 300 or (p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health <= 0) then
            currentFlingIndex = currentFlingIndex + 1
        end
    else
        currentFlingIndex = currentFlingIndex + 1
    end
end)

