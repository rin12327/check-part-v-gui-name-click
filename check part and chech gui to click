local selectedFlingPlayers = {}
local selectedAttackTarget = nil

local function createPlayerDropdown(titleText, isMultiSelect, callback)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 25)
    Label.BackgroundTransparency = 1
    Label.Text = titleText
    Label.TextColor3 = Color3.fromRGB(200, 200, 200)
    Label.TextSize = 13
    Label.Font = Enum.Font.SourceSansBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ContentContainer

    local DropContainer = Instance.new("ScrollingFrame")
    DropContainer.Size = UDim2.new(1, 0, 0, 85)
    DropContainer.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    DropContainer.BackgroundTransparency = 0.5
    DropContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    DropContainer.ScrollBarThickness = 4
    DropContainer.Parent = ContentContainer

    local DropLayout = Instance.new("UIListLayout")
    DropLayout.SortOrder = Enum.SortOrder.LayoutOrder
    DropLayout.Padding = UDim.new(0, 2)
    DropLayout.Parent = DropContainer

    local function refreshList()
        for _, child in ipairs(DropContainer:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 28)
                btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.Text = "  " .. p.DisplayName .. " (@" .. p.Name .. ")"
                btn.TextSize = 13
                btn.Font = Enum.Font.SourceSans
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = DropContainer
                local pCorner = Instance.new("UICorner") pCorner.CornerRadius = UDim.new(0, 6) pCorner.Parent = btn

                if isMultiSelect and table.find(selectedFlingPlayers, p.Name) then
                    btn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                elseif not isMultiSelect and selectedAttackTarget == p.Name then
                    btn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
                end
                btn.MouseButton1Click:Connect(function()
                    callback(p.Name, btn)
                    refreshList()
                end)
            end
        end
        DropContainer.CanvasSize = UDim2.new(0, 0, 0, #Players:GetPlayers() * 30)
    end
    Players.PlayerAdded:Connect(refreshList)
    Players.PlayerRemoving:Connect(refreshList)
    refreshList()
end

