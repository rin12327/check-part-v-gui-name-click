btnPath.MouseButton1Click:Connect(function() handleCopy(currentUIPath, btnPath, "Copy Path", Color3.fromRGB(40, 167, 69)) end)
btnPos.MouseButton1Click:Connect(function() handleCopy(currentUIPosStr, btnPos, "Copy Pos", Color3.fromRGB(220, 100, 0)) end)
btnSize.MouseButton1Click:Connect(function() handleCopy(currentUISizeStr, btnSize, "Copy Size", Color3.fromRGB(180, 40, 80)) end)

-- Biến lưu UI đang được chọn cố định
local selectedUI = nil
local hoveredUI = nil

-- Hàm lấy đường dẫn đầy đủ của UI Object
local function getFullName(obj)
    local path = obj.Name
    local parent = obj.Parent
    while parent and parent ~= game and parent ~= CoreGui and parent ~= PlayerGui do
        path = parent.Name .. "." .. path
        parent = parent.Parent
    end
    return path
end

-- Hàm cập nhật thông tin UI lên bảng
local function updateUIInfo(uiObj)
    if not uiObj or not uiObj.Parent then return end
    selectedUI = uiObj

    currentUIName = uiObj.Name
    currentUIClass = uiObj.ClassName
    currentUIPath = getFullName(uiObj)

    local absPos = uiObj.AbsolutePosition
    local absSize = uiObj.AbsoluteSize

    currentUIPosStr = string.format("%.0f, %.0f", absPos.X, absPos.Y)
    currentUISizeStr = string.format("%.0f x %.0f", absSize.X, absSize.Y)

    statusLabel.Text = "• Tên UI: " .. currentUIName ..
                       "\n• Loại (Class): " .. currentUIClass ..
                       "\n• Vị trí (AbsPos): " .. currentUIPosStr ..
                       "\n• Kích thước (AbsSize): " .. currentUISizeStr ..
                       "\n• Path: " .. currentUIPath

    -- Cập nhật khung viền bám theo UI được chọn
    selectionBox.Size = UDim2.new(0, absSize.X, 0, absSize.Y)
    selectionBox.Position = UDim2.new(0, absPos.X, 0, absPos.Y)
    selectionBox.Visible = true
end

-- 3. Xử lý Rê chuột (Hover) trên PC để hiện viền theo thời gian thực
RunService = game:GetService("RunService")
RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    local guiObjects = PlayerGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
    
    -- Lọc không lấy chính các khung GUI của công cụ Inspector
    local targetUI = nil
    for _, obj in ipairs(guiObjects) do
        if not obj:IsDescendantOf(screenGui) then
            targetUI = obj
            break
        end
    end

    if targetUI then
        hoveredUI = targetUI
        local absPos = targetUI.AbsolutePosition
        local absSize = targetUI.AbsoluteSize
        
        -- Nếu chưa click cố định thì viền chạy theo chuột hover (màu trắng mờ)
        if not selectedUI or selectedUI ~= targetUI then
            boxStroke.Color = Color3.fromRGB(255, 255, 255)
            selectionBox.Size = UDim2.new(0, absSize.X, 0, absSize.Y)
            selectionBox.Position = UDim2.new(0, absPos.X, 0, absPos.Y)
            selectionBox.Visible = true
        end
    else
        if not selectedUI then
            selectionBox.Visible = false
        end
    end
end)

-- 4. Xử lý Click (PC) hoặc Touch (Mobile) để chọn và khóa thông tin UI
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position
        local guiObjects = PlayerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)
        
        local targetUI = nil
        for _, obj in ipairs(guiObjects) do
            if not obj:IsDescendantOf(screenGui) then
                targetUI = obj
                break
            end
        end

        if targetUI then
            boxStroke.Color = Color3.fromRGB(0, 255, 255) -- Đổi sang xanh ngọc khi đã click chọn
            updateUIInfo(targetUI)
        end
    end
end)
