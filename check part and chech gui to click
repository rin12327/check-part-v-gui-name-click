btnPath.MouseButton1Click:Connect(function() handleCopy(currentPath, btnPath, "Copy Path", Color3.fromRGB(40, 167, 69)) end)
btnPos.MouseButton1Click:Connect(function() handleCopy(currentPosStr, btnPos, "Copy Position", Color3.fromRGB(220, 100, 0)) end)
btnSize.MouseButton1Click:Connect(function() handleCopy(currentSizeStr, btnSize, "Copy Size", Color3.fromRGB(180, 40, 80)) end)

-- Biến lưu Part đã chọn
local selectedTarget = nil

-- Hàm xử lý chọn Part chung cho cả PC và Mobile
local function processTargetSelection(inputPosition)
    local unitRay = Camera:ScreenPointToRay(inputPosition.X, inputPosition.Y)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local char = LocalPlayer.Character
    if char then
        raycastParams.FilterDescendantsInstances = {char, screenGui}
    else
        raycastParams.FilterDescendantsInstances = {screenGui}
    end

    local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 500, raycastParams)
    
    if raycastResult and raycastResult.Instance then
        local target = raycastResult.Instance
        if target:IsA("BasePart") then
            selectedTarget = target

            currentPartName = target.Name
            currentParentName = target.Parent and target.Parent.Name or "Không có Parent"
            currentPath = target:GetFullName()

            local pos = target.Position
            local size = target.Size

            currentPosStr = string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
            currentSizeStr = string.format("X: %.2f | Y: %.2f | Z: %.2f", size.X, size.Y, size.Z)

            statusLabel.Text = "• Tên Part: " .. currentPartName ..
                               "\n• Parent: " .. currentParentName ..
                               "\n• Tọa độ (Position): " .. currentPosStr ..
                               "\n• Kích thước (Size): " .. currentSizeStr ..
                               "\n• Path: " .. currentPath

            local model = target:FindFirstAncestorOfClass("Model")
            highlight.Adornee = model or target
        end
    end
end

-- 3. Xử lý sự kiện click / chạm màn hình
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        processTargetSelection(input.Position)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        processTargetSelection(input.Position)
    end
end)
